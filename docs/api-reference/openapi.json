              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseMeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "csrf",
        "responses" : {
          "200" : {
            "description" : "OK",
