          "userId" : {
            "type" : "string"
          },
          "permissionCodes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            },
            "uniqueItems" : true
          }
        }
      }
    },
    "securitySchemes" : {
      "cookieAuth" : {
        "type" : "apiKey",
        "description" : "로그인 응답으로 발급되는 HttpOnly 세션 토큰 쿠키",
        "name" : "TC_UI_AUTH",
        "in" : "cookie"
      }
    }
  }
}