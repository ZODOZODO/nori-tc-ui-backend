{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "TC MES UI Backend API",
    "description" : "TC MES UI 백엔드 REST API. 인증은 로그인 시 발급되는 HttpOnly 쿠키(`TC_UI_AUTH`)의 세션 토큰으로 처리되며, endpoint 별 인가는 tc_user_group_permission 권한 모델을 단일 진실 원천으로 한다. endpoint 와 권한 코드 매핑은 docs/api-reference/openapi.md 참조.",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "security" : [ {
    "cookieAuth" : [ ]
  } ],
  "paths" : {
